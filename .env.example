# eBay OAuth stays server-side. Never commit real values.
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_CALLBACK_URL=https://worker.example.invalid/ebay/oauth/callback
# Independent 32-byte keys, base64 encoded. Set the active environment's key only.
EBAY_TOKEN_KEY_SANDBOX=
EBAY_TOKEN_KEY_PRODUCTION=
# Account deletion notification endpoint and secrets (Worker-only in deployment).
EBAY_DELETION_ENDPOINT=https://worker.example.invalid/ebay/account-deletion
EBAY_DELETION_VERIFICATION_TOKEN=
EBAY_DELETION_HASH_KEY=

# MCP binds to loopback for Secure MCP Tunnel/local clients.
HOST=127.0.0.1
PORT=3000
